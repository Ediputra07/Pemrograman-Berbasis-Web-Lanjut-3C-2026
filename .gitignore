# Root Gitignore for Monorepo Laravel Praktikum

# Laravel Ignore Rules (Wildcard for any student subfolder)
**/vendor/
**/node_modules/
**/.env
**/.env.backup
**/.env.production
**/.env.*.local
**/storage/*.key
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*
**/bootstrap/cache/*
**/public/storage
**/public/build
**/.phpunit.result.cache
**/Homestead.json
**/Homestead.yaml
**/auth.json
**/npm-debug.log
**/yarn-error.log

# IDE & OS Ignore Rules
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
